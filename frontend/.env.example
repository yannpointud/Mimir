# Configuration Frontend Mimir

# API Configuration
VITE_API_BASE_URL=/api/v1

# Environment
VITE_APP_NAME=Mimir
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION="Assistant documentaire intelligent"

# Debug & Development
# Warnings and errors always reach the browser console. VITE_ENABLE_LOGS
# adds info logs, VITE_DEBUG_MODE adds debug logs, and VITE_LOG_TO_FILE sends
# every emitted log to the backend (backend/logs/frontend.log).
VITE_DEBUG_MODE=false
VITE_ENABLE_LOGS=false
VITE_LOG_TO_FILE=false

# Performance
VITE_ENABLE_SOURCE_MAPS=false
VITE_CHUNK_SIZE_WARNING_LIMIT=1000

# Branding
VITE_COMPANY_NAME=Arch-IT
