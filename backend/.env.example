# Mimir backend configuration.
# Copy to backend/.env (the backend reads .env from its working directory).
# Every key maps to a field of mimir/config.py; unknown keys abort startup.

# API
API_VERSION=v1
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=sqlite:///./data/sqlite/mimir.db
SQLITE_WAL_MODE=true

# LLM (Mistral)
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest
MISTRAL_EMBEDDING_MODEL=mistral-embed
EMBEDDING_BATCH_SIZE=50

# Vector store
FAISS_INDEX_PATH=./data/faiss/index.bin
FAISS_METADATA_PATH=./data/faiss/metadata.json
EMBEDDING_DIMENSION=1024

# File system
DATA_DIR=./data
UPLOAD_DIR=./data/documents

# Security: change these values in production
JWT_SECRET_KEY=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=2
# Admin password: set one of the two. ADMIN_PASSWORD (clear text, hashed at
# startup) takes precedence. Generate a hash with:
#   python -c "from mimir.auth.jwt_handler import JWTHandler; print(JWTHandler().hash_password('your_password'))"
# ADMIN_PASSWORD=a_strong_password
ADMIN_PASSWORD_HASH=your_argon2_hash_here
# Comma-separated allowed Host headers ('*' disables the check)
TRUSTED_HOSTS=*

# Rate limiting (per client and per minute)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=10

# Environment and logging
ENVIRONMENT=development
LOG_LEVEL=INFO

# Daily AI budget in euros
DAILY_BUDGET_EUR=20.0

# RAG debug logging (keep disabled in production)
RAG_DEBUG_ENABLED=false
RAG_DEBUG_LOG_PROMPTS=false
RAG_DEBUG_LOG_CONTEXT=false
RAG_DEBUG_LOG_RESPONSES=false

# Email (escalations and error alerts)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_USE_TLS=true
ESCALATION_EMAIL=support@example.com
