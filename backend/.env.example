# Mimir Configuration - Backend Principal
# Ce fichier est la configuration PRINCIPALE chargée par l'application
# Copier ce fichier en .env et renseigner les valeurs

# ================================
# API Configuration
# ================================
API_VERSION=v1
API_HOST=0.0.0.0
API_PORT=8000

# ================================
# Database Configuration
# ================================
DATABASE_URL=sqlite:///./data/sqlite/mimir.db
SQLITE_WAL_MODE=true

# ================================
# LLM Configuration
# ================================
LLM_PROVIDER=mistral
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest
MISTRAL_EMBEDDING_MODEL=mistral-embed
EMBEDDING_BATCH_SIZE=50

# ================================
# Vector Store Configuration
# ================================
VECTOR_STORE_TYPE=faiss
FAISS_INDEX_PATH=./data/faiss/index.bin
FAISS_METADATA_PATH=./data/faiss/metadata.json
EMBEDDING_DIMENSION=1024

# ================================
# Sources and Confidence Configuration
# ================================
# Seuil minimal de similarité vectorielle (0.0-1.0) pour qu'un chunk soit considéré pertinent
SIMILARITY_THRESHOLD=0.5

# Nombre maximum de chunks à retourner dans le contexte final (limite haute)
MAX_SOURCES=8

# Nombre minimum de chunks à retourner si disponibles
MIN_SOURCES=1

# Algorithme de calcul du score de confiance : "simple" (moyenne) ou "weighted" (pondéré par scores)
CONFIDENCE_ALGORITHM=weighted

# Boost additif appliqué aux chunks dont le filename matche avec la question (0.0-2.0)
FILENAME_BOOST=0.1

# Pourcentage d'écart maximum (0.05-0.5) par rapport au meilleur score pour filtrage dynamique
DYNAMIC_FILTER_PERCENTAGE=0.20

# Filename Pre-inclusion (fuzzy matching)
# Active la pré-inclusion des chunks par fuzzy matching AVANT la recherche vectorielle
FILENAME_PRE_INCLUSION=true

# Seuil minimum de fuzzy matching (0-100) pour pré-inclure tous les chunks d'un document
FILENAME_FUZZY_THRESHOLD=80

# ================================
# Ingestion Configuration
# ================================
# Taille maximale de la queue d'ingestion (protection contre DoS par upload massif)
INGESTION_QUEUE_MAX_SIZE=50000
MAX_CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_CHUNKS_PER_DOC=2000
MAX_FILE_SIZE_MB=100

# ================================
# File System Configuration
# ================================
DATA_DIR=./data
UPLOAD_DIR=./data/documents
WATCH_FOLDER=./data/watch
WATCH_ENABLED=true

# ================================
# Security Configuration
# ================================
# IMPORTANT: Changer ces valeurs en production
JWT_SECRET_KEY=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=2

# Générer avec : python -c "from src.auth.jwt_handler import JWTHandler; print(JWTHandler().hash_password('votre_password'))"
# Default: Abc1234
ADMIN_PASSWORD_HASH=your_bcrypt_hash_here

# ================================
# Cache Configuration
# ================================
CACHE_ENABLED=true
CACHE_MAX_SIZE=100
CACHE_TTL=3600

# ================================
# Rate Limiting
# ================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=20

# ================================
# Environment & Logging
# ================================
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# ================================
# RAG Debug Configuration
# ================================
# DÉSACTIVER en production pour réduire drastiquement les logs
RAG_DEBUG_ENABLED=false
RAG_DEBUG_LOG_PROMPTS=false
RAG_DEBUG_LOG_CONTEXT=false
RAG_DEBUG_LOG_RESPONSES=false

# ================================
# Performance
# ================================
MAX_CONCURRENT_REQUESTS=50
REQUEST_TIMEOUT=30

# ================================
# Health Check
# ================================
HEALTH_CHECK_INTERVAL=60

# ================================
# Email Configuration (Escalade)
# ================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_smtp_password
SMTP_USE_TLS=true
ESCALATION_EMAIL=support@example.com
