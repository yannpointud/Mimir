# Backend build-context excludes (Information Disclosure mitigation T-05-05-01).
# NOTE: docker reads the .dockerignore from the ROOT of the active build
# context. The compose backend service builds with `context: .` (repo root), so
# the authoritative ignore file is the repo-root /.dockerignore. This file is
# kept in sync for anyone building with `backend/` as the context directly and
# documents the intent at the backend level.

# Secrets AND the env template — never enter an image layer
.env
.env.*

# Runtime data & logs (provided by the named volume / bind mounts at runtime)
data/
logs/
*.log
*.pid

# Python caches / virtualenvs
**/__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
coverage*/
htmlcov/

# VCS
.git/

# Tests (not shipped in the runtime image)
tests/
